# Cloud Run / Vertex AI (recommended; no API key in production)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=x-cycling-506610-p8
GOOGLE_CLOUD_LOCATION=global
CLOUD_RESEARCH_MODEL=gemini-3.7-flash
CLOUD_RESEARCH_LIVE_MODEL=gemini-live-2.5-flash-native-audio
CLOUD_RESEARCH_JOB=cloud-research-shift
CLOUD_RESEARCH_JOB_LOCATION=us-central1
CLOUD_RESEARCH_FIRESTORE_DATABASE=(default)

# Local Vertex authorization-key mode: use these four values without
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION, so ADK keeps using the key.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_API_KEY=replace-me
# CLOUD_RESEARCH_VERTEX_PROJECT=x-cycling-506610-p8
# CLOUD_RESEARCH_VERTEX_LOCATION=us-central1

# Optional local Google AI Studio mode. Never commit the real value.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=replace-me

# Optional: publish research artifacts to one repository.
# GITHUB_TOKEN=replace-me
# GITHUB_REPOSITORY=owner/repository
# GITHUB_WEBHOOK_SECRET=replace-me
